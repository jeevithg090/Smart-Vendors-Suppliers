# -----------------------------------------------------------------------------
# Frontend (Vite) variables — copy this file to `.env.local` and fill in values.
#
# IMPORTANT: every VITE_* variable is inlined into the browser bundle at build
# time and is therefore PUBLIC. Only use keys that are restricted to your domain
# or that you are comfortable exposing. Server-side secrets belong in the Convex
# dashboard (see the bottom of this file), never here.
# -----------------------------------------------------------------------------

# Convex deployment used by `npx convex dev` (written automatically by the CLI)
CONVEX_DEPLOYMENT=

# Public URL of your Convex deployment, e.g. https://<name>.convex.cloud
VITE_CONVEX_URL=

# Sarvam AI — multilingual speech-to-text for voice queries (https://sarvam.ai)
VITE_SARVAM_API_KEY=

# OpenRouter — LLM used to interpret voice queries/filters (https://openrouter.ai)
VITE_OPENROUTER_API_KEY=

# Optional: Google Cloud Translation fallback
VITE_GOOGLE_TRANSLATE_API_KEY=

# Optional: computer-vision providers for ingredient photo recognition
VITE_VISION_API_KEY=
VITE_CLARIFAI_API_KEY=
VITE_AZURE_VISION_API_KEY=
VITE_AZURE_VISION_ENDPOINT=

# Optional: text-to-speech provider
VITE_TTS_API_KEY=

# -----------------------------------------------------------------------------
# Convex backend environment variables — DO NOT put these in .env.local.
# Set them with `npx convex env set NAME value` or in the Convex dashboard:
#
#   OPENROUTER_API_KEY   AI inventory forecasting + FSSAI certificate analysis
#   OCR_SPACE_API_KEY    OCR for FSSAI certificate uploads (https://ocr.space)
#
# CI / deployment only (store as a CI secret, never commit):
#   CONVEX_DEPLOY_KEY    used by `npx convex deploy`
# -----------------------------------------------------------------------------
