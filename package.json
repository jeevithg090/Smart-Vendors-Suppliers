{
  "name": "smart-street",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && tsc -p convex --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:api": "node scripts/api-smoke-check.mjs",
    "deploy:backend": "convex deploy",
    "docker:build": "docker build -t smart-street .",
    "docker:run": "docker run -p 8080:8080 smart-street",
    "clean": "rm -rf dist coverage node_modules/.vite",
    "test:e2e:mock": "E2E_MOCK_BACKEND=1 playwright test",
    "ui:audit": "tsx scripts/ui/audit.ts",
    "ui:screenshots": "tsx scripts/ui/capture.ts"
  },
  "dependencies": {
    "convex": "^1.25.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.1.0",
    "react-router-dom": "^7.7.1",
    "recharts": "^3.1.0",
    "recordrtc": "^5.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/recordrtc": "^5.6.14",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.4.21",
    "convex-test": "^0.0.71",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^23.0.1",
    "msw": "^2.0.8",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^4.1.12",
    "workbox-window": "^7.3.0"
  },
  "description": "B2B sourcing platform connecting Indian street food vendors with verified raw-material suppliers",
  "engines": {
    "node": ">=20"
  }
}
